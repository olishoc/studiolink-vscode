{
  "name": "StudioLink Terminal Red",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#ff3f3f99",
    "foreground": "#f3f0ec",
    "descriptionForeground": "#a49d95",
    "errorForeground": "#ff6b6b",
    "icon.foreground": "#c9c1ba",
    "activityBar.background": "#070707",
    "activityBar.foreground": "#f3f0ec",
    "activityBar.inactiveForeground": "#6d6863",
    "activityBarBadge.background": "#9b2424",
    "activityBarBadge.foreground": "#fff4ef",
    "sideBar.background": "#0b0b0c",
    "sideBar.foreground": "#d8d0c7",
    "sideBar.border": "#ffffff1c",
    "sideBarTitle.foreground": "#ff5a5a",
    "sideBarSectionHeader.background": "#151111",
    "sideBarSectionHeader.foreground": "#f3f0ec",
    "editor.background": "#060606",
    "editor.foreground": "#eee8e1",
    "editorLineNumber.foreground": "#5d5752",
    "editorLineNumber.activeForeground": "#ff3f3f",
    "editorCursor.foreground": "#ff3f3f",
    "editor.selectionBackground": "#7f242466",
    "editor.inactiveSelectionBackground": "#4a1b1b66",
    "editor.lineHighlightBackground": "#ff3f3f0f",
    "editorIndentGuide.background1": "#ffffff12",
    "editorIndentGuide.activeBackground1": "#ff3f3f55",
    "editorWhitespace.foreground": "#ffffff1a",
    "editorWidget.background": "#111111",
    "editorWidget.border": "#ff3f3f55",
    "editorSuggestWidget.background": "#101010",
    "editorSuggestWidget.border": "#ff3f3f44",
    "editorSuggestWidget.selectedBackground": "#451414",
    "editorHoverWidget.background": "#101010",
    "editorHoverWidget.border": "#ff3f3f44",
    "statusBar.background": "#140909",
    "statusBar.foreground": "#f3f0ec",
    "statusBar.border": "#ff3f3f33",
    "statusBar.debuggingBackground": "#5b1616",
    "titleBar.activeBackground": "#090909",
    "titleBar.activeForeground": "#f3f0ec",
    "titleBar.inactiveBackground": "#050505",
    "titleBar.inactiveForeground": "#6d6863",
    "tab.activeBackground": "#101010",
    "tab.activeForeground": "#ffffff",
    "tab.activeBorderTop": "#ff3f3f",
    "tab.inactiveBackground": "#090909",
    "tab.inactiveForeground": "#8a817a",
    "panel.background": "#070707",
    "panel.border": "#ffffff1c",
    "panelTitle.activeForeground": "#ff5a5a",
    "panelTitle.inactiveForeground": "#8a817a",
    "terminal.background": "#030303",
    "terminal.foreground": "#eee8e1",
    "terminalCursor.foreground": "#ff3f3f",
    "terminal.ansiRed": "#ff3f3f",
    "terminal.ansiBrightRed": "#ff6b6b",
    "terminal.ansiYellow": "#f0b35a",
    "terminal.ansiGreen": "#75d28d",
    "terminal.ansiBlue": "#a16a5f",
    "terminal.ansiMagenta": "#d85f5f",
    "terminal.ansiCyan": "#c48771",
    "terminal.ansiWhite": "#f3f0ec",
    "button.background": "#7f1d1d",
    "button.foreground": "#fff4ef",
    "button.hoverBackground": "#a32828",
    "input.background": "#080808",
    "input.foreground": "#f3f0ec",
    "input.border": "#ffffff24",
    "dropdown.background": "#080808",
    "dropdown.foreground": "#f3f0ec",
    "dropdown.border": "#ffffff24",
    "list.activeSelectionBackground": "#451414",
    "list.activeSelectionForeground": "#fff4ef",
    "list.hoverBackground": "#2a1111",
    "list.inactiveSelectionBackground": "#251010",
    "badge.background": "#9b2424",
    "badge.foreground": "#fff4ef",
    "scrollbarSlider.background": "#ffffff18",
    "scrollbarSlider.hoverBackground": "#ff3f3f33",
    "scrollbarSlider.activeBackground": "#ff3f3f55"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6d6863", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#ff5a5a" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#f0b35a" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#75d28d" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#f3f0ec" }
    },
    {
      "scope": ["variable", "support.variable"],
      "settings": { "foreground": "#d8d0c7" }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": { "foreground": "#c48771" }
    }
  ]
}
